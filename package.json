{
  "name": "gtnh-bee-tree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Searchable bee breeding tree and quest path for GregTech: New Horizons",
  "scripts": {
    "icons": "node tools/build-icons.mjs",
    "predev": "npm run icons",
    "dev": "react-router dev",
    "prebuild": "npm run icons",
    "build": "react-router typegen && tsc --noEmit && react-router build",
    "preview": "vite preview --outDir build/pages",
    "pretest": "npm run icons",
    "test": "vitest run",
    "typecheck": "npm run icons && react-router typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
